source /container/base/functions/container/init
prepare_service 20-authentik-outpost
SERVICE_NAME="outpost-rac"

check_container_initialized
check_service_initialized init 20-authentik-outpost

liftoff

print_start "Starting Authentik outpost (rac) $(grep -o "ADD: Authentik .* |" /container/build/${IMAGE_NAME/\//_}/build.log | awk '{print $3}')"
export HOME=/opt/authentik
_outpost_map_proxy rac
export AUTHENTIK_LISTEN__METRICS="${AUTHENTIK_LISTEN__METRICS:-[::]:${RAC_METRICS_PORT}}"
export PROMETHEUS_MULTIPROC_PATH="${METRICS_PATH%/}/rac"
_outpost_map_logging
_outpost_run_logged rac "${RAC_LOG_TYPE}" "${RAC_LOG_PATH}" "${RAC_LOG_FILE}" /usr/local/bin/authentik-rac
