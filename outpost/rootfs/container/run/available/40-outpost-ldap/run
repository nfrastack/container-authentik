source /container/base/functions/container/init
prepare_service 20-authentik-outpost
SERVICE_NAME="outpost-ldap"

check_container_initialized
check_service_initialized init 20-authentik-outpost

liftoff

print_start "Starting Authentik outpost (ldap)"
export HOME=/opt/authentik
_outpost_map_proxy ldap
export AUTHENTIK_LISTEN__METRICS="${AUTHENTIK_LISTEN__METRICS:-[::]:${LDAP_METRICS_PORT}}"
export PROMETHEUS_MULTIPROC_PATH="${METRICS_PATH%/}/ldap"
_outpost_map_logging
_outpost_run_logged ldap "${LDAP_LOG_TYPE}" "${LDAP_LOG_PATH}" "${LDAP_LOG_FILE}" /usr/local/bin/authentik-ldap
