source /container/base/functions/container/init
prepare_service 20-authentik-outpost
SERVICE_NAME="outpost-radius"

check_container_initialized
check_service_initialized init 20-authentik-outpost

liftoff

print_start "Starting Authentik outpost (radius) $(grep -o "ADD: Authentik .* |" /container/build/${IMAGE_NAME/\//_}/build.log | awk '{print $3}')"
export HOME=/opt/authentik
_outpost_map_proxy radius
export AUTHENTIK_LISTEN__METRICS="${AUTHENTIK_LISTEN__METRICS:-[::]:${RADIUS_METRICS_PORT}}"
export PROMETHEUS_MULTIPROC_PATH="${METRICS_PATH%/}/radius"
_outpost_map_logging
_outpost_run_logged radius "${RADIUS_LOG_TYPE}" "${RADIUS_LOG_PATH}" "${RADIUS_LOG_FILE}" /usr/local/bin/authentik-radius
