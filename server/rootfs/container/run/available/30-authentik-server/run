#!/command/with-contenv bash
# SPDX-FileCopyrightText: © 2026 Nfrastack <code@nfrastack.com>
#
# SPDX-License-Identifier: MIT

source /container/base/functions/container/init
prepare_service 20-authentik
SERVICE_NAME="authentik-server"

check_container_initialized
check_service_initialized init 20-authentik

liftoff

print_start "Starting Authentik  $(grep -o "ADD: Authentik .* |" /container/build/${IMAGE_NAME/\//_}/build.log | awk '{print $3}') server"
export VIRTUAL_ENV=/opt/authentik
export PATH="/opt/authentik/bin:/usr/local/bin:${PATH}"
export HOME=/opt/authentik
authentik_map_database
authentik_map_paths
export AUTHENTIK_LISTEN__METRICS="${AUTHENTIK_LISTEN__METRICS:-[::]:${SERVER_METRICS_PORT}}"
export PROMETHEUS_MULTIPROC_PATH="${METRICS_PATH}"
cd /usr/share/authentik
authentik_run_logged server ak server
