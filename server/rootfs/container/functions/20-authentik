authentik_bootstrap_filesystem() {
    create_folder \
                    "${CERTS_PATH},\
                    ${DATA_PATH},\
                    /media,\ ## EH?
                    ${BLUEPRINTS_PATH},\
                    ${TEMPLATE_PATH}" \
                    ${AUTHENTIK_USER}:${AUTHENTIK_GROUP} 755

    if [ ! -e "${DATA_PATH%/}/media" ] ; then
        ln -s /media "${DATA_PATH%/}"/media
        chown -h ${AUTHENTIK_USER}:${AUTHENTIK_GROUP} "${DATA_PATH%/}"/media
    fi

    create_folder "${PROMETHEUS_MULTIPROC_PATH}" "${AUTHENTIK_USER}":"${AUTHENTIK_GROUP}"
}

authentik_mode_enabled() {
    local _modes=",$(echo "${AUTHENTIK_MODE,,}" | tr -d '[:space:]'),"
    case "${_modes}" in
        *",${1},"* )
            return 0
        ;;
        * )
            return 1
        ;;
    esac
}

authentik_configure_mode() {
    local _mode
    for _mode in $(echo "${AUTHENTIK_MODE,,}" | tr ',' ' ') ; do
        case "${_mode}" in
            server | worker | proxy )
                :
            ;;
            * )
                print_error "Unknown AUTHENTIK_MODE entry '${_mode}' (valid: server,worker,proxy)"
                return 1
            ;;
        esac
    done
}

authentik_map_database() {
    export AUTHENTIK_POSTGRESQL__HOST="${AUTHENTIK_POSTGRESQL__HOST:-${DB_HOST}}"
    export AUTHENTIK_POSTGRESQL__PORT="${AUTHENTIK_POSTGRESQL__PORT:-${DB_PORT}}"
    export AUTHENTIK_POSTGRESQL__NAME="${AUTHENTIK_POSTGRESQL__NAME:-${DB_NAME}}"
    export AUTHENTIK_POSTGRESQL__USER="${AUTHENTIK_POSTGRESQL__USER:-${DB_USER}}"
    export AUTHENTIK_POSTGRESQL__PASSWORD="${AUTHENTIK_POSTGRESQL__PASSWORD:-${DB_PASS}}"
}

authentik_map_proxy() {
    if authentik_mode_enabled server ; then
        AUTHENTIK_HOST=${AUTHENTIK_HOST:-"http://localhost:9000"}
        export AUTHENTIK_HOST
    fi
}

authentik_map_logging() {
    export AUTHENTIK_LOG_LEVEL="$1"
}

authentik_run_logged() {
    local _tag="$1" _type="$2" _dir="$3" _file="$4"
    shift 4
    local _log="${_dir%/}/${_file}"
    case "${_type,,}" in
        file | both )
            mkdir -p "${_log%/*}"
            chown "${AUTHENTIK_USER}":"${AUTHENTIK_GROUP}" "${_log%/*}"
            touch "${_log}"
            chown "${AUTHENTIK_USER}":"${AUTHENTIK_GROUP}" "${_log}"
            create_logrotate "authentik-${_tag}" "${_log}" none "${AUTHENTIK_USER}" "${AUTHENTIK_GROUP}"
            print_debug "Logging (${_type}) to ${_log}"
        ;;
    esac
    case "${_type,,}" in
        file )
            exec s6-setuidgid "${AUTHENTIK_USER}" "$@" >>"${_log}" 2>&1
        ;;
        both )
            export AUTHENTIK_LOGFILE="${_log}"
            exec s6-setuidgid "${AUTHENTIK_USER}" bash -c 'exec "$@" > >(tee -a "${AUTHENTIK_LOGFILE}") 2>&1' authentik-run "$@"
        ;;
        * )
            exec s6-setuidgid "${AUTHENTIK_USER}" "$@"
        ;;
    esac
}

authentik_map_paths() {
    export AUTHENTIK_STORAGE__FILE__PATH="${AUTHENTIK_STORAGE__FILE__PATH:-${DATA_PATH}}"
    export AUTHENTIK_EMAIL__TEMPLATE_DIR="${AUTHENTIK_EMAIL__TEMPLATE_DIR:-${TEMPLATE_PATH}}"
    export AUTHENTIK_BLUEPRINTS_DIR="${AUTHENTIK_BLUEPRINTS_DIR:-${BLUEPRINTS_PATH}}"
    export AUTHENTIK_CERT_DISCOVERY_DIR="${AUTHENTIK_CERT_DISCOVERY_DIR:-${CERTS_PATH}}"
}
